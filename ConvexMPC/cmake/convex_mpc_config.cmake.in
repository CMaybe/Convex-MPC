@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_package(Eigen3 3.4 CONFIG REQUIRED QUIET)
if(NOT TARGET Eigen3::Eigen)
  message(FATAL_ERROR "Eigen3 not found. Ensure it is installed and accessible.")
endif()


set_and_check(convex_mpc_INCLUDE_DIRS "@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(convex_mpc_LIB_DIRS "@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_LIBDIR@")

set(convex_mpc_FOUND TRUE) 
include("${convex_mpc_LIB_DIRS}/cmake/convex_mpc/convex_mpc-targets.cmake")
